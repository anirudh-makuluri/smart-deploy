# Application resources must live in the separately owned, deletable workload stack.
rule control_plane_only {
    Resources.*.Type IN ["AWS::StepFunctions::StateMachine", "AWS::Events::Rule", "AWS::SQS::QueuePolicy", "AWS::IAM::Role", "AWS::SQS::Queue", "AWS::Logs::LogGroup"]
}

rule bounded_cleanup {
    Resources.CleanupWorkflow.Properties.StateMachineType == "STANDARD"
    Resources.CleanupWorkflow.Properties.Definition.TimeoutSeconds == 9300
    Resources.CleanupWorkflow.Properties.Definition.States.ExpiryTimer.Timestamp == {"Fn::Sub":"${CleanupStartUtc}"}
    Resources.CleanupWorkflow.Properties.Definition.States.RetryDelay.Seconds == 60
    Resources.CleanupWorkflow.Properties.Definition.States.CleanupWindow.Default == "CleanupIncomplete"
    Resources.CleanupWorkflow.Properties.Definition.States.CleanupWindow.Choices[0].Condition == "{% $toMillis($states.context.State.EnteredTime) < $states.input.config.expiresAt + 1800000 and $states.input.round < 30 %}"
    Resources.CleanupFailureRule.Properties.Targets[*].RetryPolicy.MaximumEventAgeInSeconds <= 300
    Resources.CleanupFailureRule.Properties.Targets[*].RetryPolicy.MaximumRetryAttempts <= 3
}

rule protected_audit {
    Resources.CleanupDlq.Properties.SqsManagedSseEnabled == true
    Resources.CleanupDlq.Properties.MessageRetentionPeriod <= 604800
    Resources.CleanupDlq.DeletionPolicy == "Retain"
    Resources.CleanupDlq.UpdateReplacePolicy == "Retain"
    Resources.CleanupLogs.Properties.RetentionInDays <= 7
    Resources.CleanupLogs.DeletionPolicy == "Retain"
    Resources.CleanupWorkflow.Properties.LoggingConfiguration.Level == "ERROR"
    Resources.CleanupWorkflow.Properties.LoggingConfiguration.IncludeExecutionData == false
}

rule worker_lease {
    let stop = Resources.CleanupRole.Properties.Policies[*].PolicyDocument.Statement[Action == "ec2:StopInstances"]
    %stop not empty
    %stop.Resource == {"Fn::Sub":"arn:aws:ec2:${AWS::Region}:${AWS::AccountId}:instance/${WorkerInstanceId}"}
    %stop.Condition == {"StringEquals":{"ec2:ResourceTag/smartdeploy:demo-id":{"Ref":"DemoId"}}}
}

rule interface_lease {
    let detach = Resources.CleanupRole.Properties.Policies[*].PolicyDocument.Statement[Action == "ec2:ModifyNetworkInterfaceAttribute"]
    %detach not empty
    %detach.Resource == {"Fn::Sub":"arn:aws:ec2:${AWS::Region}:${AWS::AccountId}:network-interface/${WorkerEniId}"}
    %detach.Condition == {"StringEquals":{"ec2:ResourceTag/smartdeploy:demo-id":{"Ref":"DemoId"}}}
}

rule workflow_identity {
    Resources.CleanupRole.Properties.AssumeRolePolicyDocument.Statement[*].Principal.Service == "states.amazonaws.com"
    Resources.CleanupRole.Properties.AssumeRolePolicyDocument.Statement[*].Condition == {"StringEquals":{"aws:SourceAccount":{"Ref":"AWS::AccountId"},"aws:SourceArn":{"Fn::Sub":"arn:aws:states:${AWS::Region}:${AWS::AccountId}:stateMachine:sdp-guard-${DemoId}"}}}
}
